# Обязательно: адрес LiteLLM (без /v1 на конце)
LLM_BASE_URL=http://litellm.example.lan:4000
# Обязательно: имя модели как в LiteLLM (список: curl $LLM_BASE_URL/v1/models)
LLM_MODEL=qwen3-8b
# Ключ LiteLLM, если нужен
LLM_API_KEY=
# Сколько секунд ждать ответа модели
LLM_TIMEOUT=120
# Секрет в адресе: /connect host:8765/<BRIDGE_TOKEN>. Обязателен, если мост доступен из интернета
BRIDGE_TOKEN=
BRIDGE_PORT=8765
